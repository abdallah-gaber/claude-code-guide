---
// Fades/rises elements marked data-reveal into view as they scroll into the viewport.
// Import once per page that uses data-reveal (currently just the homepage).
---

<script>
  function initScrollReveal() {
    const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');
    if (targets.length === 0) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      targets.forEach((el) => el.classList.add('is-visible'));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: '0px 0px -10% 0px' }
    );

    targets.forEach((el) => observer.observe(el));

    // Safety net: never let content stay permanently invisible (e.g. a backgrounded tab
    // that never reports intersection, or an IntersectionObserver edge case).
    setTimeout(() => {
      targets.forEach((el) => el.classList.add('is-visible'));
      observer.disconnect();
    }, 2500);
  }

  initScrollReveal();
  document.addEventListener('astro:page-load', initScrollReveal);
</script>
