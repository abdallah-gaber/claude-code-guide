---
interface Props {
  storageKey: string;
  items: string[];
}

const { storageKey, items } = Astro.props;
---

<ul class="checklist" data-storage-key={`ccg-checklist:${storageKey}`}>
  {
    items.map((item, index) => (
      <li>
        <label>
          <input type="checkbox" data-index={index} />
          <span>{item}</span>
        </label>
      </li>
    ))
  }
</ul>
<p class="checklist-progress" data-role="progress" aria-live="polite"></p>

<style>
  .checklist {
    list-style: none;
    margin: 1.25rem 0;
    padding: 0;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
    overflow: hidden;
  }

  .checklist li {
    border-bottom: 1px solid var(--sl-color-hairline);
  }

  .checklist li:last-child {
    border-bottom: none;
  }

  .checklist label {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    padding: 0.65rem 1rem;
    cursor: pointer;
  }

  .checklist input[type='checkbox'] {
    margin-top: 0.2rem;
    width: 1.05rem;
    height: 1.05rem;
    accent-color: var(--sl-color-accent);
    flex-shrink: 0;
  }

  .checklist label:has(input:checked) span {
    text-decoration: line-through;
    opacity: 0.6;
  }

  .checklist-progress {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
    margin: 0.5rem 0 1.5rem 0;
  }
</style>

<script>
  function initChecklists() {
    document.querySelectorAll<HTMLUListElement>('.checklist[data-storage-key]').forEach((list) => {
      const key = list.dataset.storageKey!;
      const checkboxes = Array.from(list.querySelectorAll<HTMLInputElement>('input[type="checkbox"]'));
      const progressEl = list.parentElement?.querySelector<HTMLParagraphElement>(
        `.checklist-progress[data-role="progress"]`
      );

      const readState = (): boolean[] => {
        try {
          const raw = localStorage.getItem(key);
          return raw ? JSON.parse(raw) : [];
        } catch {
          return [];
        }
      };

      const writeState = (state: boolean[]) => {
        try {
          localStorage.setItem(key, JSON.stringify(state));
        } catch {
          // localStorage unavailable (private mode, disabled storage) — degrade silently
        }
      };

      const updateProgress = () => {
        const done = checkboxes.filter((cb) => cb.checked).length;
        if (progressEl) {
          progressEl.textContent = `${done} of ${checkboxes.length} done`;
        }
      };

      const saved = readState();
      checkboxes.forEach((cb, i) => {
        cb.checked = Boolean(saved[i]);
        cb.addEventListener('change', () => {
          const state = checkboxes.map((c) => c.checked);
          writeState(state);
          updateProgress();
        });
      });
      updateProgress();
    });
  }

  initChecklists();
  document.addEventListener('astro:page-load', initChecklists);
</script>
