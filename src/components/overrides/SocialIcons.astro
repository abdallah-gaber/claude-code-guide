---
// Same as Starlight's default SocialIcons.astro, but adds a real `title` attribute so the
// link gets a native hover tooltip — the default only sets screen-reader-only text, which
// gives sighted mouse users no indication of what the icon links to.
import config from 'virtual:starlight/user-config';
import { Icon } from '@astrojs/starlight/components';

const links = config.social || [];
---

{
  links.length > 0 && (
    <>
      {links.map(({ label, href, icon }) => (
        <a href={href} rel="me" class="sl-flex" title={label}>
          <span class="sr-only">{label}</span>
          <Icon name={icon} />
        </a>
      ))}
    </>
  )
}

<style>
  @layer starlight.core {
    a {
      color: var(--sl-color-text-accent);
      padding: 0.5em;
      margin: -0.5em;
    }
    a:hover {
      color: var(--sl-color-white);
    }
  }
</style>
